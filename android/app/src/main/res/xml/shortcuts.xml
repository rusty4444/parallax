<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Android suggest the recent chats published by ShareShortcuts.kt in
     the share sheet (Direct Share). The category must match CATEGORY there,
     and the types must match MainActivity's SEND filters in the manifest. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="net.samrussell.parallax.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="net.samrussell.parallax.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
